{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mavsdd-operations",
  "title": "mavsdd Operations Manifest",
  "description": "operations.json per unit, enumerating every file change the unit intends to apply. Plan §15.1 canonical keys are `unit` and `ops`; legacy `unitId` / `operations` are accepted for backward compatibility.",
  "type": "object",
  "required": ["feature"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "feature": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "unitId": { "type": "string", "minLength": 1 },
    "baselineId": { "type": ["string", "null"] },
    "generatedAt": { "type": "string" },
    "changedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requirementCoverage": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ops": {
      "type": "array",
      "items": { "$ref": "#/definitions/operation" }
    },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/definitions/operation" }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "operation": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": ["add", "overwrite", "delete", "rename", "chmod"]
        },
        "kind": {
          "type": "string",
          "enum": ["add", "modify", "delete", "rename", "chmod"]
        },
        "path": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "baseHash": { "type": ["string", "null"] },
        "contentHash": { "type": ["string", "null"] },
        "newHash": { "type": ["string", "null"] },
        "newContent": { "type": ["string", "null"] },
        "mode": { "type": ["string", "number", "null"] },
        "baseMode": { "type": ["string", "number", "null"] },
        "requirementRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    }
  }
}
