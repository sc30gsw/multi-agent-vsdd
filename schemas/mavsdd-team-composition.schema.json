{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mavsdd-team-composition",
  "title": "mavsdd Team Composition",
  "description": "Planner-produced team composition describing implementer units and their scope.",
  "type": "object",
  "required": ["feature", "units"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "feature": { "type": "string", "minLength": 1 },
    "teamName": { "type": "string" },
    "generatedAt": { "type": "string" },
    "maxParallel": { "type": "number", "minimum": 1, "maximum": 5 },
    "executionStrategy": { "type": "string" },
    "planner": { "type": "object" },
    "reviewers": { "type": "object" },
    "implementers": { "type": "object" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/unit" }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "unit": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "role": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writePaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writeFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "briefPath": { "type": "string" },
        "verificationTier": {
          "type": "string",
          "enum": ["tier0", "tier1", "tier2", "tier3"]
        },
        "originClusterId": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
